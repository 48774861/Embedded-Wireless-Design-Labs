options:
  parameters:
    author: ECE 5377/7377
    catch_exceptions: 'True'
    category: '[ECE 5377/7377]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Lab 4 finite guarded degree-10 PN transmitter
    gen_cmake: 'Off'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: lab4_finite_pn_transmitter
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Lab 4: Finite PN File Source to N310'
    window_size: (1800,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: center_frequency
  id: variable
  parameters:
    comment: ''
    value: float(os.environ.get('ECE7377_CENTER_FREQUENCY', '2.45e9'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 28.0]
    rotation: 0
    state: enabled
- name: lab_root
  id: variable
  parameters:
    comment: ''
    value: os.environ.get('ECE7377_LAB4_ROOT', os.path.expanduser('~/ECE7377/Lab4'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 108.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: float(os.environ.get('ECE7377_SAMPLE_RATE', '1.25e6'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 28.0]
    rotation: 0
    state: enabled
- name: transmit_samples
  id: variable
  parameters:
    comment: ''
    value: os.path.getsize(tx_file) // 8
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 28.0]
    rotation: 0
    state: enabled
- name: tx_antenna
  id: variable
  parameters:
    comment: ''
    value: os.environ.get('ECE7377_TX_ANTENNA', 'TX/RX')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 180.0]
    rotation: 0
    state: enabled
- name: tx_device_args
  id: variable
  parameters:
    comment: ''
    value: os.environ.get('ECE7377_TX_DEVICE_ARGS', 'addr=10.61.40.60')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 180.0]
    rotation: 0
    state: enabled
- name: tx_file
  id: variable
  parameters:
    comment: ''
    value: os.environ.get('ECE7377_TX_FILE', os.path.join(lab_root, 'work/waveforms/task3_degree10_pn_burst_c64.dat'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 108.0]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: ''
    value: float(os.environ.get('ECE7377_TX_GAIN', '25'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 28.0]
    rotation: 0
    state: enabled
- name: tx_subdevice
  id: variable
  parameters:
    comment: ''
    value: os.environ.get('ECE7377_TX_SUBDEVICE', 'A:0')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 180.0]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: ''
    file: tx_file
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 320]
    rotation: 0
    state: enabled
- name: blocks_head_0
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: transmit_samples
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [248, 356.0]
    rotation: 0
    state: enabled
- name: import_os
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import os
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [72, 148.0]
    rotation: 0
    state: enabled
